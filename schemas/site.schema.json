{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web 2.0 Next website submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "url", "description"],
  "properties": {
    "$schema": { "const": "../schemas/site.schema.json" },
    "name": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "url": { "$ref": "#/$defs/webUrl" },
    "description": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "author": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "tags": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 24, "pattern": "\\S" }
    },
    "rss": { "$ref": "#/$defs/webUrl" },
    "works": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
          "url": { "$ref": "#/$defs/webUrl" }
        }
      }
    }
  },
  "$defs": {
    "plainText": {
      "type": "string",
      "$comment": "Text is also published in RSS; reject characters forbidden by XML 1.0 while preserving normal Unicode and whitespace.",
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]*$"
    },
    "webUrl": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 }
  }
}
