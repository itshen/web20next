{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web20next",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "routes": [
    { "pattern": "web20next.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
