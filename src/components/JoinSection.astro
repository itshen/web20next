---
import { messages, localizedPath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = messages(locale);
---
<section id="join" class="join" aria-labelledby="join-title">
  <div><h2 id="join-title">{t.joinTitle}</h2><p>{t.joinIntro}</p></div>
  <div class="join-actions"><a class="join-action" href={`${localizedPath(locale, 'join')}#agent-guide`}>{t.agentAction}</a><a class="join-explanation" href={localizedPath(locale, 'how-it-works')}>{t.howItWorks}</a></div>
</section>
