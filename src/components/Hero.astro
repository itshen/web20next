---
import { messages, localizedPath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = messages(locale);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="hello">{t.heroBadge}</div>
    <h1 id="hero-title">{t.heroLine1}<br />{t.heroLine2}</h1>
    <p class="intro">{t.heroIntro1}<br />{t.heroIntro2}<br /><strong>{t.heroEmphasis}</strong></p>
    <div class="actions"><a class="button" href="#manifesto">{t.readManifesto}</a><a class="text-link" href={localizedPath(locale, 'websites')}>{t.explore}</a></div>
    <p class="hero-note">{t.heroNote}<a href={`${localizedPath(locale, 'join')}#agent-guide`}>{t.agentAction}</a><a class="how-link" href={localizedPath(locale, 'how-it-works')}>{t.howItWorks}</a></p>
  </div>
  <div class="hero-art" role="img" aria-label={t.artLabel}>
    <div class="orbit" aria-hidden="true"></div><div class="orbit two" aria-hidden="true"></div><div class="planet" aria-hidden="true"></div>
    <div class="sticker blog" aria-hidden="true">{t.artGreeting}</div><div class="sticker rss" aria-hidden="true">{t.artRss}</div>
    <div class="home-window" aria-hidden="true">
      <div class="window-bar"><i class="dot"></i><i class="dot"></i><i class="dot"></i><span class="address">my-place.example</span></div>
      <div class="window-content"><div class="avatar">&#9786;</div><strong>{t.artTitle}</strong><p>{t.artText1}<br />{t.artText2}</p><div class="fake-links"><span>{t.artAbout}</span><span>{t.artWorks}</span><span>{t.artFriends}</span></div></div>
    </div>
    <div class="sticker agent" aria-hidden="true"><i class="agent-icon"></i>{t.artAgent}</div><div class="connection-dot" aria-hidden="true"></div><div class="art-caption" aria-hidden="true">{t.artCaption}</div>
  </div>
</section>
